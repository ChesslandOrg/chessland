####
# JVM-mode container for a Chessland Quarkus microservice, built via Mill.
#
# Mill puts every module's build output under out/<module>/... at the repo root
# (unlike Maven, where each module had its own target/). This single Dockerfile
# is parameterized by MODULE and works for all five services.
#
# Before building the image, from the repo root, run:
#
#   ./mill <module>.quarkusRunJar
#
# Then build the image (BUILD CONTEXT MUST BE THE REPO ROOT, not the module folder):
#
#   docker build -f Dockerfile.jvm --build-arg MODULE=player-core -t chessland/player-core .
#
# Run it:
#
#   docker run -i --rm -p 8080:8080 chessland/player-core
###
FROM registry.access.redhat.com/ubi9/openjdk-25-runtime:1.24

ENV LANGUAGE='en_US:en'

ARG MODULE

# Four separate COPY layers: when only application code changes, the
# dependency layers (lib/, quarkus/) are still reused from the Docker cache.
COPY --chown=185 out/${MODULE}/quarkusApp.dest/quarkus/quarkus-app/lib/      /deployments/lib/
COPY --chown=185 out/${MODULE}/quarkusApp.dest/quarkus/quarkus-app/*.jar    /deployments/
COPY --chown=185 out/${MODULE}/quarkusApp.dest/quarkus/quarkus-app/app/     /deployments/app/
COPY --chown=185 out/${MODULE}/quarkusApp.dest/quarkus/quarkus-app/quarkus/ /deployments/quarkus/

EXPOSE 8080
USER 185
ENV JAVA_OPTS_APPEND="-Dquarkus.http.host=0.0.0.0 -Djava.util.logging.manager=org.jboss.logmanager.LogManager"
ENV JAVA_APP_JAR="/deployments/quarkus-run.jar"

ENTRYPOINT [ "/opt/jboss/container/java/run/run-java.sh" ]
